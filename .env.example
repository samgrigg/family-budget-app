PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
APP_ORIGIN=http://localhost:3000
# Register this exact URI in Plaid Dashboard > Developers > API > Allowed redirect URIs.
PLAID_REDIRECT_URI=http://localhost:3000/
# For production: use https://localhost:3000 and https://localhost:3000/ above.
# TLS_KEY_PATH=certs/localhost-key.pem
# TLS_CERT_PATH=certs/localhost.pem
