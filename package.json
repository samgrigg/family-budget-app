{
  "name": "family-budget-poc",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env server/index.ts",
    "build": "vite build",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "test": "vitest run --root .",
    "typecheck": "tsc --noEmit",
